# Copy to .env and fill in. See the "Environment Variables" table in CLAUDE.md.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_compliance
# DATABASE_POOL_MAX=20

# Comma-separated allowed origins. Leave unset to allow all origins.
CORS_ORIGIN=

# Signs auth access/refresh tokens. Use a long random string.
JWT_SECRET=

# S3 document storage. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY can be omitted
# where the AWS SDK default credential chain (profile, IAM role) is available.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_KEY_PREFIX=documents/

# Required for PDF/image parsing (CSV parsing doesn't need it)
LLAMA_PARSE_API_KEY=

# Anthropic (agent-skill workflows, report narrative, report chat)
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_SKILL_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_REPORT_CHAT_MODEL=claude-haiku-4-5-20251001

# Report jobs claimed per poll per replica
# REPORT_QUEUE_CONCURRENCY=3
