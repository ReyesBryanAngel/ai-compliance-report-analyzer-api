        <mxCell id="e15" value="not yet COMPLETED (poll again)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n13" target="n10">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="1445" />
              <mxPoint x="200" y="1070" />
            </Array>
          </mxGeometry>
