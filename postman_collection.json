		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"  const json = pm.response.json();",
									"  if (json.token) pm.collectionVariables.set('accessToken', json.token);",
									"  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
									"  if (json.user) {",
									"    pm.collectionVariables.set('userId', json.user.id || '');",
									"    pm.collectionVariables.set('organizationId', json.user.organizationId || '');",
									"  }",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Jane Doe\",\n  \"organizationName\": \"Acme Bank\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
