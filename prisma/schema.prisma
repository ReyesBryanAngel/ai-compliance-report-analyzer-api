generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reports   Report[]

  @@map("users")
}

model Report {
  id          String            @id @default(uuid())
  title       String?
  content     String?           @db.Text
  status      ReportStatus      @default(PENDING)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  checks      ComplianceCheck[]
  documentIds String[]          @default([])
  workflows   String[]          @default([])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("reports")
}

model ComplianceCheck {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  rule      String
  passed    Boolean
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("compliance_checks")
}

enum ReportStatus {
  PENDING
  ANALYZING
  COMPLETED
  FAILED
}

model DocumentBatch {
  id          String     @id @default(uuid())
  name        String
  description String?    @db.Text
  documents   Document[]
  createdAt   DateTime   @default(now())

  @@map("document_batches")
}

model Document {
  id           String         @id @default(uuid())
  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String
  status       DocumentStatus @default(PENDING)
  batchId      String?
  batch        DocumentBatch? @relation(fields: [batchId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("documents")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  COMPLETED
  FAILED
}
