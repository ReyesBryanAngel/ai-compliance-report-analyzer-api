generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  users                  User[]
  reports                Report[]
  documents              Document[]
  checkpointOverrides    OrgCheckpointOverride[]
  thresholdConfigs       OrgThresholdConfig[]
  workflowConfigs        OrgWorkflowConfig[]
  agentSkillInstructions AgentSkillInstruction[]

  @@map("organizations")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  name                   String?
  password               String
  organizationId         String?
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  reports                Report[]
  documents              Document[]
  refreshTokens          RefreshToken[]
  agentSkillInstructions AgentSkillInstruction[]
  reportConversations    ReportConversation[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
}

model Report {
  id                  String               @id @default(uuid())
  title               String?
  content             String?              @db.Text
  status              ReportStatus         @default(GENERATING)
  userId              String?
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  checks              ComplianceCheck[]
  workflowExecutions  WorkflowExecution[]
  reportConversations ReportConversation[]
  documentIds         String[]             @default([])
  workflows           String[]             @default([])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("reports")
}

model ComplianceCheck {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  rule      String
  passed    Boolean
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("compliance_checks")
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

model DocumentBatch {
  id          String     @id @default(uuid())
  name        String
  description String?    @db.Text
  documents   Document[]
  createdAt   DateTime   @default(now())

  @@map("document_batches")
}

model Document {
  id             String         @id @default(uuid())
  originalName   String
  storedName     String
  mimeType       String
  size           Int
  path           String
  status         DocumentStatus @default(PROCESSING)
  parsedData     Json?
  batchId        String?
  batch          DocumentBatch? @relation(fields: [batchId], references: [id])
  uploadedById   String?
  uploadedBy     User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  parseJob       ParseJob?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("documents")
}

enum DocumentStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model ParseJob {
  id          String         @id @default(uuid())
  documentId  String         @unique
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status      ParseJobStatus @default(QUEUED)
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  error       String?
  queuedAt    DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@map("parse_jobs")
}

enum ParseJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Workflow {
  id                     String                  @id @default(uuid())
  slug                   String                  @unique
  name                   String
  description            String?                 @db.Text
  enabled                Boolean                 @default(true)
  checkpoints            Checkpoint[]
  orgConfigs             OrgWorkflowConfig[]
  agentSkillInstructions AgentSkillInstruction[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@map("workflows")
}

model Checkpoint {
  id                  String                  @id @default(uuid())
  workflowId          String
  workflow            Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  slug                String
  name                String
  description         String?                 @db.Text
  enabled             Boolean                 @default(true)
  orgOverrides        OrgCheckpointOverride[]
  orgThresholdConfigs OrgThresholdConfig[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([workflowId, slug])
  @@map("checkpoints")
}

model OrgCheckpointOverride {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkpointId   String
  checkpoint     Checkpoint   @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(true)

  @@unique([organizationId, checkpointId])
  @@map("org_checkpoint_overrides")
}

model OrgThresholdConfig {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkpointId   String
  checkpoint     Checkpoint   @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  greenMax       Int
  amberMax       Int
  params         Json?
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, checkpointId])
  @@map("org_threshold_configs")
}

enum WorkflowMode {
  CHECKPOINTS
  AGENT_SKILL
}

model OrgWorkflowConfig {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  mode           WorkflowMode @default(CHECKPOINTS)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, workflowId])
  @@map("org_workflow_configs")
}

model AgentSkillInstruction {
  id             String        @id @default(uuid())
  workflowId     String
  workflow       Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        Int
  title          String?
  content        String        @db.Text
  isActive       Boolean       @default(false)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([workflowId, organizationId, version])
  @@map("agent_skill_instructions")
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AgentMessageRole {
  SYSTEM
  USER
  ASSISTANT
}

model WorkflowExecution {
  id           String            @id @default(uuid())
  reportId     String
  report       Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  workflowSlug String
  mode         WorkflowMode
  status       ExecutionStatus   @default(RUNNING)
  overallScore Int?
  error        String?           @db.Text
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  conversation AgentConversation?

  @@index([reportId])
  @@map("workflow_executions")
}

model AgentConversation {
  id                  String            @id @default(uuid())
  workflowExecutionId String            @unique
  workflowExecution   WorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)
  executions          AgentExecution[]
  createdAt           DateTime          @default(now())

  @@map("agent_conversations")
}

model AgentExecution {
  id               String            @id @default(uuid())
  conversationId   String
  conversation     AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  skillSlug        String
  provider         String
  model            String
  sequence         Int               @default(1)
  status           ExecutionStatus   @default(RUNNING)
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  error            String?           @db.Text
  messages         AgentMessage[]
  startedAt        DateTime          @default(now())
  completedAt      DateTime?

  @@index([conversationId])
  @@map("agent_executions")
}

model AgentMessage {
  id               String           @id @default(uuid())
  agentExecutionId String
  agentExecution   AgentExecution   @relation(fields: [agentExecutionId], references: [id], onDelete: Cascade)
  role             AgentMessageRole
  content          String           @db.Text
  sequence         Int
  createdAt        DateTime         @default(now())

  @@index([agentExecutionId])
  @@map("agent_messages")
}

enum ConversationMessageRole {
  USER
  ASSISTANT
}

model ReportConversation {
  id        String                      @id @default(uuid())
  reportId  String
  userId    String?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  report    Report                      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  ReportConversationMessage[]

  @@index([reportId])
  @@map("report_conversations")
}

model ReportConversationMessage {
  id               String                  @id @default(uuid())
  conversationId   String
  role             ConversationMessageRole
  content          String                  @db.Text
  sequence         Int
  model            String?
  provider         String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  createdAt        DateTime                @default(now())
  conversation     ReportConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequence])
  @@map("report_conversation_messages")
}
